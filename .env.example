# ── Server ──────────────────────────────
PORT=3001
NODE_ENV=production

# ── Redis (Railway auto-sets this) ──────
REDIS_URL=redis://localhost:6379

# ── Base44 CRM ──────────────────────────
# Get from: Base44 Dashboard → Settings → API Keys
BASE44_API_URL=https://api.base44.com/api/apps
BASE44_APP_ID=your_app_id_here
BASE44_API_KEY=your_api_key_here

# ── AI / Ollama (optional) ───────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
EMBED_MODEL=nomic-embed-text

# ── Session ──────────────────────────────
SESSION_DIR=.wa-sessions
MAX_RECONNECT_ATTEMPTS=5
RECONNECT_DELAY_MS=3000

# ── Logging ──────────────────────────────
LOG_LEVEL=info
CORS_ORIGINS=*
